# ── docker compose ──────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
NEXBILL_OWNER_PASSWORD=change-me-owner
NEXBILL_APP_PASSWORD=change-me-app
# 32+ random characters, e.g.  openssl rand -base64 48
JWT_SECRET=
PUBLIC_WEB_URL=http://localhost:3000

# ── local development without Docker (packages/database/.env and the API read these) ──
# The API must connect as the unprivileged app role, migrations as the owner role.
DATABASE_URL=postgresql://nexbill_app:nexbill_app@localhost:5432/nexbill?schema=public
DATABASE_MIGRATION_URL=postgresql://nexbill_owner:nexbill@localhost:5432/nexbill?schema=public
# API_URL=http://localhost:4000         # where the web app proxies /api to
# DB_POOL_SIZE=20                       # size for peak concurrent billing transactions
# RATE_LIMIT_PER_MINUTE=600
# AUTH_RATE_LIMIT_PER_MINUTE=20
# EXPOSE_DEV_TOKENS=false               # never true in production
# GST_B2CL_THRESHOLD=100000             # verify against the current notification
